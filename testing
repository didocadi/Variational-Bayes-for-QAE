def likelihood(a, ms, xs):
    theta = np.arcsin(np.sqrt(a))
    likelihood = []
    prob = 1
    for i in range(len(ms)):
        h_k = xs[i]
        prob *= (((np.sin((2*ms[i]+1)*theta))**2)**h_k)*(((np.cos((2*ms[i]+1)*theta))**2)**(1-h_k))
    return prob

def neg_log_likelihood(a, ms, xs, N):
    a_val = a[0] if isinstance(a, (list, np.ndarray)) else a
    if a_val <= 0 or a_val >= 1:
        return np.inf
    try:
        theta = np.arcsin(np.sqrt(a_val))
        log_prob = 0.0
        for i in range(len(ms)):
            h_k = xs[i]
            p1 = np.sin((2 * ms[i] + 1) * theta) ** 2
            p0 = 1 - p1
            if p1 <= 0 or p0 <= 0:
                return np.inf
            log_prob += np.log(p1 if h_k == 1 else p0)
        return -log_prob  # directly return negative log-likelihood
    except Exception:
        return np.inf

    
