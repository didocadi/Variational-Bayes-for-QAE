def optimize_likelihood(a,ms,xs,N):
    ms_cumulative = []
    xs_cumulative = []
    probs = []
    for m,x in zip(ms,xs):
        # Repeat m N times
        ms_cumulative.extend([m] * N)
        # Extend xs_cumulative with the N binary outcomes (0s and 1s)
        xs_cumulative.extend(x)
        res = minimize_scalar(
            neg_log_likelihood,
            bounds=(0.01, 0.99),
            args=(ms_cumulative, xs_cumulative, N),
            method='bounded'
        )
        probs.append(res.x)
    return probs



